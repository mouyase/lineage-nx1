<?xml version="1.0" encoding="UTF-8"?>
<!--
  BLUEFOX NX1 (yk313_k69v1_64) - LineageOS 24.0 build manifest
  
  Device:  Bluefox NX1, MediaTek MT6769V/CB (Helio G81)
  SoC ID:  ro.board.platform=mt6768
  Target:  LineageOS 24.0 (Android 17)
  
  Base device tree is lineage-23.2 (Android 16).
  Branch adaptation happens via patches/ (applied after sync).
  
  Usage:
    mkdir -p .repo/local_manifests
    cp nx1.xml .repo/local_manifests/
    repo sync -c -j8 force-sync no-clone-bundle no-tags
-->
<manifest>

  <!-- ===================== Device-specific ===================== -->

  <!-- Device tree. Only lineage-23.2 exists upstream; 24.0 adaptation
       is done through patches/0001..0005 applied post-sync. -->
  <project name="Bluefox-Devices-Development/android_device_bluefox_NX1"
           path="device/bluefox/NX1"
           remote="github"
           revision="lineage-23.2" />

  <!-- Prebuilt GKI 6.6 kernel, 187 kernel modules, dtbo.img.
       Repo only has a lineage-23.2 branch but it is a binary drop:
       the branch name carries no ABI meaning for the kernel itself. -->
  <project name="Bluefox-Devices-Development/android_device_bluefox_NX1-kernels"
           path="device/bluefox/NX1-kernels"
           remote="github"
           revision="lineage-23.2" />

  <!-- 883 proprietary blobs (561 MB): vendor libs, firmware, audio params.
       Extracted from T69_S39_BLUEFOX_NX1_20260602 stock firmware. -->
  <project name="Bluefox-Devices-Development/proprietary_vendor_bluefox_NX1"
           path="vendor/bluefox/NX1"
           remote="github"
           revision="lineage-23.2" />

  <!-- ===================== Platform support ===================== -->

  <!-- MTK vendor sepolicy. This repo DOES have a lineage-24.0 branch,
       unlike lineage.dependencies suggests. -->
  <project name="Bluefox-Devices-Development/android_device_mediatek_sepolicy_vndr"
           path="device/mediatek/sepolicy_vndr"
           remote="github"
           revision="lineage-24.0" />

  <!-- MTK HAL implementations: wifi, bluetooth, audio, camera, thermal,
       memtrack, boot control (ufs-bsg), usb gadget. -->
  <project name="Bluefox-Devices-Development/android_hardware_mediatek"
           path="hardware/mediatek"
           remote="github"
           revision="lineage-24.0" />

  <!-- Lineage compatibility shims for MTK. -->
  <project name="Bluefox-Devices-Development/android_hardware_lineage_compat"
           path="hardware/lineage/compat"
           remote="github"
           revision="lineage-24.0" />

  <!-- ===================== Telephony / framework ===================== -->
  <!--
    Optional. These repos carry MTK telephony and framework patches
    (IMS, VoLTE, InCallService gain control). Enabling them improves
    call audio reliability but significantly lengthens sync time.
    Uncomment only if you need MTK IMS fixes baked into the ROM.
  -->

  <!--
  <project name="Bluefox-Devices-Development/android_frameworks_opt_telephony"
           path="frameworks/opt/telephony"
           remote="github"
           revision="lineage-24.0" />
  -->

</manifest>
